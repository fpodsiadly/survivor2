<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity package sources (../com.surv.core/Runtime) outside Unity.
       Keep to Unity 6 limits: C# 9, .NET Standard 2.1, no records/init. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Surv.Core</AssemblyName>
    <RootNamespace>Surv.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../com.surv.core/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
