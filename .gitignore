# Unity project lives in game/ (PLAN.md D2)
/game/[Ll]ibrary/
/game/[Tt]emp/
/game/[Oo]bj/
/game/[Bb]uild/
/game/[Bb]uilds/
/game/[Ll]ogs/
/game/[Uu]ser[Ss]ettings/
/game/[Mm]emoryCaptures/
/game/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/game/[Aa]ssets/**/*.meta

# Autogenerated IDE / solution files
/game/.vs/
/game/.vscode/
/game/.idea/
/game/.utmp/
/game/*.csproj
/game/*.unityproj
/game/*.sln
/game/*.slnx
/game/*.suo
/game/*.tmp
/game/*.user
/game/*.userprefs
/game/*.pidb
/game/*.booproj
/game/*.svd
/game/*.pdb
/game/*.mdb
/game/*.opendb
/game/*.VC.db
/game/*.pidb.meta
/game/*.pdb.meta
/game/*.mdb.meta

# Build outputs and crash reports
*.apk
*.aab
*.unitypackage
*.app
sysinfo.txt
crashlytics-build.properties

# Burst debug info
/game/[Aa]ssets/[Ss]treamingAssets/aa.meta
/game/[Aa]ssets/[Ss]treamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# OS
.DS_Store
Thumbs.db

# .NET build output for core/ (PLAN.md, Odstępstwa)
/core/**/bin/
/core/**/obj/
